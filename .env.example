# YouTube Data API v3
YOUTUBE_API_KEY=

# Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint Online
SHAREPOINT_HOSTNAME=your-tenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/YourSiteName
SHAREPOINT_LIST_NAME=YouTube動画管理

# Auto-populated by scripts/setup_sharepoint.py
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=

# Cloud synced config path in SharePoint Documents library
SHAREPOINT_CONFIG_PATH=YouTubeCollector/config.json

# Optional login password for Streamlit Community Cloud
APP_PASSWORD=
